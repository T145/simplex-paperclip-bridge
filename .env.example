# Copy to .env and fill in at deploy time. Never commit real values.

# SimpleX core WebSocket endpoint (local only).
SIMPLEX_WS_URL=ws://127.0.0.1:5225

# Paperclip public API.
PAPERCLIP_API_URL=https://example.invalid
PAPERCLIP_API_TOKEN=replace-me
PAPERCLIP_COMPANY_ID=replace-me
PAPERCLIP_PROJECT_ID=replace-me

# Identity the bridge posts as. Must be a dedicated identity that is not the
# assignee of the issues it writes to, so that bridge comments wake the
# assignee.
BRIDGE_AGENT_ID=replace-me

# Allowlist of SimpleX chats. Comma separated. An entry is either a scoped id
# such as direct:12 or group:34, or a display name matched case insensitively.
SIMPLEX_ALLOWLIST=replace-me

# Routing prefix. A message that starts with this prefix followed by an issue
# identifier or UUID is added as a comment to that issue instead of creating a
# new issue.
BRIDGE_ISSUE_REFERENCE_PREFIX=#

# Optional routing for newly created issues.
BRIDGE_DEFAULT_ASSIGNEE_AGENT_ID=
BRIDGE_DEFAULT_PRIORITY=

# Bounded poll interval for the Paperclip to SimpleX direction, in milliseconds.
BRIDGE_POLL_INTERVAL_MS=15000

# Local state file path.
BRIDGE_STATE_PATH=./state/bridge-state.json

# Message size limit, in bytes, applied before a message reaches either API.
BRIDGE_MAX_MESSAGE_BYTES=8000

# Timeouts and retry behaviour, in milliseconds.
BRIDGE_COMMAND_TIMEOUT_MS=15000
BRIDGE_REQUEST_TIMEOUT_MS=20000
BRIDGE_MAX_RETRIES=4
BRIDGE_RETRY_BASE_MS=500
BRIDGE_RETRY_MAX_MS=30000

# Number of processed SimpleX message ids retained for deduplication.
BRIDGE_PROCESSED_HISTORY_LIMIT=2000

# Log level: debug, info, warn, error.
BRIDGE_LOG_LEVEL=info
