# Copy to .env and fill in at deploy time. Never commit real values.

# SimpleX core WebSocket endpoint (local only).
SIMPLEX_WS_URL=ws://127.0.0.1:5225

# Paperclip public API.
PAPERCLIP_API_URL=https://example.invalid
PAPERCLIP_API_TOKEN=replace-me
PAPERCLIP_PROJECT_ID=replace-me

# Identity the bridge posts as. Must be a dedicated identity that is not the
# assignee of the issues it writes to, so that bridge comments wake the
# assignee.
BRIDGE_AGENT_ID=replace-me

# Allowlist of SimpleX contacts and groups. Comma separated.
SIMPLEX_ALLOWLIST=replace-me

# Bounded poll interval for the Paperclip to SimpleX direction, in milliseconds.
BRIDGE_POLL_INTERVAL_MS=15000

# Local state file path.
BRIDGE_STATE_PATH=./state/bridge-state.json

# Log level: debug, info, warn, error.
BRIDGE_LOG_LEVEL=info
